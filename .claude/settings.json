{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"deny": [
			"Read(.env)",
			"Read(.env.local)",
			"Read(.env.development)",
			"Read(.env.production)"
		],
		"ask": [
			"Bash(pnpm dev)",
			"Bash(pnpm dev *)",
			"Bash(pnpm dlx *)",
			"Bash(pnpx *)",
			"Bash(pnpm add *)",
			"Bash(pnpm install)",
			"Bash(pnpm install *)"
		],
		"allow": [
			"Bash(pnpm verify)",
			"Bash(pnpm run verify)",
			"Bash(pnpm lint:ci)",
			"Bash(pnpm run lint:ci)",
			"Bash(pnpm tsc)",
			"Bash(pnpm run tsc)",
			"Bash(pnpm fsd)",
			"Bash(pnpm run fsd)",
			"Bash(pnpm test)",
			"Bash(pnpm test *)",
			"Bash(pnpm run test)",
			"Bash(pnpm run test *)",
			"Bash(pnpm build)",
			"Bash(pnpm run build)"
		]
	}
}
