# Backend API base URL, including any base path (server-side only, validated in src/shared/config/env.ts)
# Also used by `pnpm generate-api`: the OpenAPI spec is fetched from ${API_URL}/${SPEC_PATH} (see openapi-ts.config.ts)
API_URL=https://petstore3.swagger.io/api/v3

# Public site origin for robots.txt / sitemap.xml (optional, defaults to
# http://localhost:3000). Those routes are force-dynamic, so like API_URL this
# is read at runtime — pass it to the container when deploying.
#SITE_URL=https://example.com
