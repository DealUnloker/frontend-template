{
	"name": "frontend-template",
	"version": "1.0.2",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"build-start": "next build && next start",
		"tsc": "tsc --noEmit",
		"lint": "biome check --write .",
		"lint-unsafe": "biome check --write --unsafe .",
		"lint:ci": "biome check .",
		"verify": "pnpm lint:ci && pnpm tsc && pnpm run fsd && pnpm test",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"fsd": "steiger ./src",
		"generate-api": "openapi-ts",
		"postinstall": "lefthook install"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@t3-oss/env-nextjs": "^0.13.11",
		"@tanstack/react-query": "^5.104.5",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.61.0",
		"next": "16.4.3",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"shadcn": "^4.22.1",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@feature-sliced/steiger-plugin": "^0.8.0",
		"@hey-api/openapi-ts": "0.0.0-next-20260930190945",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"@vitest/coverage-v8": "^5.0.5",
		"babel-plugin-react-compiler": "^1.0.0",
		"jsdom": "^30.1.3",
		"lefthook": "^2.2.2",
		"steiger": "^0.8.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	},
	"packageManager": "pnpm@11.28.3",
	"engines": {
		"node": ">=24"
	}
}
