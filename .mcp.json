{
	"mcpServers": {
		"next-devtools": {
			"type": "stdio",
			"command": "npx",
			"args": ["-y", "next-devtools-mcp@latest"]
		},
		"shadcn": {
			"type": "stdio",
			"command": "pnpm",
			"args": ["exec", "shadcn", "mcp"]
		},
		"context7": {
			"type": "http",
			"url": "https://mcp.context7.com/mcp"
		}
	}
}
